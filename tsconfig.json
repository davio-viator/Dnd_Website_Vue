{
  "extends": "@vue/tsconfig/tsconfig.web.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "lib":["es2021","dom"]
  },
  "strict": true,
  "noImplicitReturns": true,

  "references": [
    {
      "path": "./tsconfig.config.json"
    }
  ]
}
